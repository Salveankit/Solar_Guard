# SolarGuard POC runtime configuration
# Use Neon PostgreSQL URLs with sslmode=require.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST/TEST_DBNAME?sslmode=require
ALLOW_DEVELOPMENT_DB_TESTS=false
SOLARGUARD_CONFIG_PATH=config/poc_config.yaml
SOLARGUARD_RAW_DATA_DIR=data/raw
SOLARGUARD_API_VERSION=1.0.0
